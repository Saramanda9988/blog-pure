---
import Figure from './Figure.astro'

// 模拟一个「设置窗确认后隐藏但不退出、游戏另起进程」的启动过程
const TAU = 2
const DT = 0.1
const X_MAX = 22
const HIDE_AT = 8 // 设置窗被点掉，只剩启动关系证据
const GAME_AT = 8.5 // 游戏进程出现

const tgt: [number, number][] = [[0, 0]]
const game: [number, number][] = [[GAME_AT, 0]]
let s = 0
let g = 0
let confirmAt = 0
let challengeFrom: number | null = null
let switchAt = 0
const alpha = 1 - Math.exp(-DT / TAU)
for (let i = 1; i * DT <= X_MAX + 1e-9; i++) {
  const t = +(i * DT).toFixed(2)
  s += alpha * ((t <= HIDE_AT ? 1 : 0.25) - s)
  tgt.push([t, s])
  if (t > GAME_AT) {
    g += alpha * (1 - g)
    game.push([t, g])
  }
  if (!confirmAt && t >= 3 && s >= 0.85) confirmAt = t
  const ok = g >= 0.6 && g - s >= 0.3
  if (!ok) challengeFrom = null
  else if (challengeFrom === null) challengeFrom = t
  if (!switchAt && challengeFrom !== null && t - challengeFrom >= 5) switchAt = t
}
const bandFrom = switchAt - 5

const L = 44
const R = 440
const T = 44
const B = 226
const sx = (t: number) => L + (t / X_MAX) * (R - L)
const sy = (v: number) => B - v * (B - T)
const pts = (ps: [number, number][]) => ps.map(([t, v]) => `${sx(t).toFixed(1)},${sy(v).toFixed(1)}`).join(' ')
const BAR = B + 36
---

<Figure caption='后台验证：设置窗被提前确认后，真正的游戏以足够的领先优势保持 5 秒，监控随之换绑' maxWidth={600}>
  <svg viewBox='0 0 560 300' role='img' aria-label='提前确认后由验证器换绑到真正游戏进程的时间线'>
    <rect x={sx(bandFrom)} y={T} width={sx(switchAt) - sx(bandFrom)} height={B - T} style='fill:var(--gd-primary);opacity:0.1'></rect>
    <text x={sx(bandFrom + 2.5)} y={B - 24} font-size="10" text-anchor="middle" class="t-primary">挑战条件</text>
    <text x={sx(bandFrom + 2.5)} y={B - 10} font-size="10" text-anchor="middle" class="t-primary">持续 5 s</text>

    {
      [0, 0.5, 1].map((v) => (
        <>
          <line x1={L} x2={R} y1={sy(v)} y2={sy(v)} class='ln-faint'></line>
          <text x={L - 8} y={sy(v)} font-size='10' text-anchor='end' dominant-baseline='central' class='t-muted'>
            {v}
          </text>
        </>
      ))
    }
    {
      [0, 4, 8, 12, 16, 20].map((t) => (
        <text x={sx(t)} y={B + 15} font-size='10' text-anchor='middle' class='t-muted'>
          {t} s
        </text>
      ))
    }
    <line x1={L} x2={R} y1={B} y2={B} class='ln'></line>

    {
      [
        { t: confirmAt, row: 0, text: '① 提前确认设置窗' },
        { t: GAME_AT, row: 1, text: '② 点击确认，游戏出现' },
        { t: switchAt, row: 0, text: '③ 换绑到游戏' }
      ].map((e) => (
        <>
          <line x1={sx(e.t)} x2={sx(e.t)} y1={T - (e.row ? 8 : 26)} y2={B} class='ln-faint ln-dash'></line>
          <text x={sx(e.t)} y={T - (e.row ? 12 : 30)} font-size='11' text-anchor='middle'>
            {e.text}
          </text>
        </>
      ))
    }

    <polyline points={pts(tgt)} fill='none' style='stroke:var(--gd-warn);stroke-width:2.2'></polyline>
    <polyline points={pts(game)} fill='none' style='stroke:var(--gd-primary);stroke-width:2.4'></polyline>
    <text x={R + 10} y={sy(g)} font-size='11' dominant-baseline='central' class='t-primary'>游戏进程</text>
    <text x={R + 10} y={sy(s) - 6} font-size='11' dominant-baseline='central' class='t-warn'>设置窗</text>
    <text x={R + 10} y={sy(s) + 9} font-size='10' dominant-baseline='central' class='t-muted'>隐藏但未退出</text>

    <text x={L - 8} y={BAR + 7} font-size='10' text-anchor='end' dominant-baseline='central' class='t-muted'>监控</text>
    <rect x={sx(0)} y={BAR} width={sx(confirmAt) - sx(0)} height='14' rx='3' class='box-ghost'></rect>
    <rect x={sx(confirmAt)} y={BAR} width={sx(switchAt) - sx(confirmAt)} height='14' rx='3' class='box-warn'></rect>
    <rect x={sx(switchAt)} y={BAR} width={sx(X_MAX) - sx(switchAt)} height='14' rx='3' class='box-game'></rect>
    <text x={(sx(0) + sx(confirmAt)) / 2} y={BAR + 7} font-size='9' text-anchor='middle' dominant-baseline='central' class='t-muted'>观察中</text>
    <text x={(sx(confirmAt) + sx(switchAt)) / 2} y={BAR + 7} font-size='10' text-anchor='middle' dominant-baseline='central'>设置窗</text>
    <text x={(sx(switchAt) + sx(X_MAX)) / 2} y={BAR + 7} font-size='10' text-anchor='middle' dominant-baseline='central'>游戏</text>
  </svg>
</Figure>
