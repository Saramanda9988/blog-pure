---
import Figure from './Figure.astro'

const L = 44
const R = 528
const T = 40
const B = 236
const X_MAX = 70
const Y_MIN = 0.4
const Y_MAX = 1
const sx = (t: number) => L + (t / X_MAX) * (R - L)
const sy = (v: number) => B - ((v - Y_MIN) / (Y_MAX - Y_MIN)) * (B - T)

const theta = (t: number, timeout: number) =>
  t < 15 ? 0.85 : t < timeout ? 0.85 - (0.3 * (t - 15)) / (timeout - 15) : 0.55
const line = (timeout: number) =>
  [3, 15, timeout].map((t) => `${sx(t).toFixed(1)},${sy(theta(t, timeout)).toFixed(1)}`).join(' ')
const T1 = 30
const T2 = 60
---

<Figure
  caption='阈值 θ(t)：3–15 秒内固定为 0.85，之后线性放宽；超时 T 变长只会让尾部更平缓'
  maxWidth={600}
>
  <svg viewBox='0 0 560 270' role='img' aria-label='确认阈值随时间变化曲线'>
    <rect x={sx(0)} y={T} width={sx(3) - sx(0)} height={B - T} style='fill:var(--gd-faint);opacity:0.6'></rect>
    <rect x={sx(3)} y={T} width={sx(15) - sx(3)} height={B - T} style='fill:var(--gd-primary);opacity:0.08'></rect>

    <text x={sx(1.5)} y={T - 22} font-size='10' text-anchor='middle' class='t-muted'>0–3 s</text>
    <text x={sx(1.5)} y={T - 9} font-size='10' text-anchor='middle' class='t-muted'>只观察</text>
    <text x={sx(9)} y={T - 22} font-size='10' text-anchor='middle' class='t-primary'>3–15 s</text>
    <text x={sx(9)} y={T - 9} font-size='10' text-anchor='middle' class='t-primary'>严格阈值</text>
    <text x={sx(37)} y={T - 9} font-size='10' text-anchor='middle' class='t-muted'>15 s – T：线性放宽到 0.55</text>

    {
      [0.4, 0.55, 0.7, 0.85, 1].map((v) => (
        <>
          <line x1={L} x2={R} y1={sy(v)} y2={sy(v)} class='ln-faint'></line>
          <text x={L - 8} y={sy(v)} font-size='10' text-anchor='end' dominant-baseline='central' class='t-muted'>
            {v}
          </text>
        </>
      ))
    }
    {
      [0, 15, 30, 45, 60].map((t) => (
        <text x={sx(t)} y={B + 16} font-size='10' text-anchor='middle' class='t-muted'>
          {t} s
        </text>
      ))
    }
    <line x1={L} x2={R} y1={B} y2={B} class='ln'></line>

    <polyline points={line(T2)} fill='none' style='stroke:var(--gd-muted);stroke-width:2;stroke-dasharray:6 4'></polyline>
    <polyline points={line(T1)} fill='none' style='stroke:var(--gd-primary);stroke-width:2.4'></polyline>

    <circle cx={sx(T1)} cy={sy(0.55)} r='4' style='fill:var(--gd-primary)'></circle>
    <text x={sx(T1)} y={sy(0.55) + 18} font-size='11' text-anchor='middle' class='t-primary'>T = 30 s 超时兜底</text>
    <circle cx={sx(T2)} cy={sy(0.55)} r='4' style='fill:var(--gd-muted)'></circle>
    <text x={sx(T2)} y={sy(0.55) + 18} font-size='11' text-anchor='middle' class='t-muted'>T = 60 s</text>
    <text x={sx(15) + 6} y={sy(0.85) - 8} font-size='10' class='t-muted'>两条曲线在 15 s 前完全重合</text>
  </svg>
</Figure>
