---
import Arrow from './Arrow.astro'
import Figure from './Figure.astro'
import Node from './Node.astro'

const rules = [
  '① 保存过的进程名已经在运行？',
  '② launcher 子孙中有唯一可见 / 前台进程？',
  '③ 游戏目录内有唯一可见 / 前台进程？',
  '④ launcher 已退出：放宽条件找唯一候选？'
]
const ruleY = (i: number) => 140 + i * 52
const RH = 34
const busX = 392
---

<Figure caption='旧方案：按顺序执行的规则链，任何一条命中就立即确认' maxWidth={560}>
  <svg viewBox='0 0 536 476' role='img' aria-label='旧检测逻辑流程图'>
    <Node x={130} y={4} w={120} label='启动游戏' kind='us' />
    <Arrow points={[[190, 32], [190, 52]]} />
    <Node x={130} y={52} w={120} label='等待 5 秒' />
    <Arrow points={[[190, 80], [190, 108]]} />

    <rect x='20' y='108' width='340' height='238' rx='10' class='region'></rect>
    <text x='34' y='127' font-size='11' class='t-muted'>每 2 秒一轮 · 每轮都是独立的快照</text>

    {
      rules.map((r, i) => (
        <>
          <Node x={40} y={ruleY(i)} w={300} h={RH} label={r} />
          <Arrow points={[[340, ruleY(i) + RH / 2], [busX, ruleY(i) + RH / 2]]} plain />
          <text x={366} y={ruleY(i) + RH / 2 - 5} font-size='10' text-anchor='middle' class='t-muted'>
            命中
          </text>
          {i < rules.length - 1 && (
            <>
              <Arrow points={[[190, ruleY(i) + RH], [190, ruleY(i + 1)]]} />
              <text x={198} y={ruleY(i) + RH + 12} font-size='10' class='t-muted'>
                否
              </text>
            </>
          )}
        </>
      ))
    }
    <Arrow points={[[busX, ruleY(0) + RH / 2], [busX, ruleY(3) + RH / 2]]} plain />
    <Arrow points={[[busX, 235], [420, 235]]} />
    <Node x={420} y={218} w={108} h={34} label='确认该进程' kind='game' />

    <Arrow points={[[190, 346], [190, 376]]} />
    <text x='200' y='365' font-size='10' class='t-muted'>全部未命中</text>
    <Node x={130} y={376} w={120} h={34} label='已经超时？' />
    <Arrow points={[[130, 393], [8, 393], [8, 124], [20, 124]]} />
    <text x='70' y='386' font-size='10' text-anchor='middle' class='t-muted'>否，下一轮</text>
    <Arrow points={[[190, 410], [190, 436]]} />
    <text x='198' y='427' font-size='10' class='t-muted'>是</text>
    <Node x={80} y={436} w={220} h={34} label='退回监控 launcher / 请用户手动选择' kind='warn' />
  </svg>
</Figure>
